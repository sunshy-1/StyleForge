# Shared defaults for generation stages. Evaluation uses run_eval.sh CLI defaults.
# Shell environment values take precedence over these defaults.
# The public one-command workflow uses GPUs 1 and 2 unless the caller
# explicitly sets CUDA_VISIBLE_DEVICES.
CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-1,2}"
# Each public generation command runs both sizes sequentially.
# MODEL_SIZE remains an optional single-size override.
MODEL_SIZES="${MODEL_SIZES:-${MODEL_SIZE:-4b 9b}}"
MODEL="${MODEL:-"models/FLUX.2-klein-{SIZE}"}"
RUN_ROOT="${RUN_ROOT:-"outputs/flux_{size}"}"
DRY_RUN="${DRY_RUN:-0}"
CHECKPOINT_ROOT="${CHECKPOINT_ROOT:-training_based_baselines/checkpoints}"
DATASET_ROOT="${DATASET_ROOT:-data/styles}"
PROMPTS_FILE="${PROMPTS_FILE:-configs/content_prompts.json}"
CONFIG="${CONFIG:-configs/default.json}"
CHECKPOINT_STEP="${CHECKPOINT_STEP:-1001}"
# Leave TASKS empty for automatic discovery of every style under DATASET_ROOT.
# It remains available as an advanced subset override.
TASKS="${TASKS:-}"
SEED="${SEED:-880000}"
STEPS="${STEPS:-4}"
GUIDANCE="${GUIDANCE:-1.0}"
DEVICE="${DEVICE:-cuda}"
DTYPE="${DTYPE:-bfloat16}"
CANDIDATE_COUNT="${CANDIDATE_COUNT:-1}"
MAX_REF_IMAGES="${MAX_REF_IMAGES:-4}"
MAX_SCHEMA_CHARS="${MAX_SCHEMA_CHARS:-2200}"
ACTUATOR_MODE="${ACTUATOR_MODE:-t3_0_dominant_chromatic_field}"
OVERWRITE="${OVERWRITE:-0}"
